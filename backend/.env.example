# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: web search for Market Opportunity section (Tavily). If unset, section uses documents only.
# TAVILY_API_KEY=

# Database: SQLite (default) or PostgreSQL
# SQLite (local file, no setup):
DATABASE_URL=sqlite:///./jarvis.db
# PostgreSQL (local via Docker or Railway):
# DATABASE_URL=postgresql://jarvis:jarvis@localhost:5432/jarvis

# Auth (required for production)
JWT_SECRET=your-long-random-secret-change-in-production

# CORS: comma-separated frontend origins (add your Vercel URL for production)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://new-era-dilligence.vercel.app

# ChromaDB (for memo RAG). On Railway, set to a volume path so vectors persist across deploys (e.g. /data/chroma).
# CHROMA_DATA_PATH=/data/chroma

# Gmail integration (OAuth)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/settings/gmail/callback

# Database backups (S3)
# BACKUP_S3_BUCKET=
# BACKUP_S3_PREFIX=jarvis-backups
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# CoS (Chief of Staff) API integration — set a shared secret here and in the CoS .env as CRM_API_KEY
# COS_API_KEY=

# Seed script: initial password for the two admin users (optional; default: ChangeMe123)
ADMIN_INITIAL_PASSWORD=
